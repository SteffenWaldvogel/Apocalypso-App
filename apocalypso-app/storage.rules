rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Campaign map images
    match /campaigns/{campaignId}/maps/{fileName} {
      // Any authenticated user can read map images
      allow read: if request.auth != null;

      // Only authenticated users can upload (max 10MB, images only)
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Character portraits (future)
    match /campaigns/{campaignId}/portraits/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
