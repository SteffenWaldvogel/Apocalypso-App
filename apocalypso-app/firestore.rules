rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user is the GM of a campaign
    function isGM(campaignId) {
      return isAuth() && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.gmId == request.auth.uid;
    }

    // Helper: check if user is a member of a campaign
    function isMember(campaignId) {
      let campaign = get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
      return isAuth() && (
        campaign.gmId == request.auth.uid
        || (campaign.keys().hasAny(['memberIds']) && request.auth.uid in campaign.memberIds)
      );
    }

    // ─── Campaigns ───────────────────────────────────────────────
    match /campaigns/{campaignId} {

      // Anyone authenticated can read campaigns they're a member of.
      // List queries filtered by memberIds array-contains are enforced by the client.
      allow read: if isAuth();

      // Any authenticated user can create a campaign (they become GM)
      allow create: if isAuth()
        && request.resource.data.gmId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // GM can update campaign. Members can update only memberIds (for joining).
      allow update: if isAuth() && (
        isGM(campaignId)
        || (
          // Non-GM members can only add themselves to memberIds
          isMember(campaignId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        )
        || (
          // New member joining: can only add themselves to memberIds
          !isMember(campaignId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.auth.uid in request.resource.data.memberIds
        )
      );

      // Only GM can delete a campaign
      allow delete: if isGM(campaignId);

      // ─── Members subcollection ──────────────────────────────────
      match /members/{userId} {
        // Members can read, but also allow users to read their own doc (for join check)
        allow read: if isAuth();

        // Users can create their own member doc (joining a campaign)
        allow create: if isAuth() && request.auth.uid == userId;

        // GM can update any member, users can update their own
        allow update: if isGM(campaignId) || (isAuth() && request.auth.uid == userId);

        // GM can remove members
        allow delete: if isGM(campaignId);
      }

      // ─── Characters subcollection ───────────────────────────────
      match /characters/{charId} {
        // All campaign members can read all characters
        allow read: if isMember(campaignId);

        // Authenticated members can create characters (playerId must be themselves)
        allow create: if isMember(campaignId)
          && request.resource.data.playerId == request.auth.uid;

        // Owner or GM can update
        allow update: if isMember(campaignId) && (
          resource.data.playerId == request.auth.uid
          || isGM(campaignId)
        );

        // Owner or GM can delete
        allow delete: if isMember(campaignId) && (
          resource.data.playerId == request.auth.uid
          || isGM(campaignId)
        );
      }

      // ─── Chat subcollection ─────────────────────────────────────
      match /chat/{messageId} {
        // Members can read all messages
        allow read: if isMember(campaignId);

        // Members can create messages (senderId must be themselves or 'system')
        allow create: if isMember(campaignId)
          && (request.resource.data.senderId == request.auth.uid
              || request.resource.data.senderId == 'system');

        // No editing or deleting chat messages
        allow update, delete: if false;
      }

      // ─── Combat state ───────────────────────────────────────────
      match /combat/{docId} {
        allow read: if isMember(campaignId);

        // Only GM can write combat state
        allow create, update: if isGM(campaignId);
        allow delete: if isGM(campaignId);
      }

      // ─── Maps ───────────────────────────────────────────────────
      match /maps/{mapId} {
        allow read: if isMember(campaignId);

        // GM can create/update/delete maps
        // Members can update (for token moves)
        allow create: if isGM(campaignId);
        allow update: if isMember(campaignId);
        allow delete: if isGM(campaignId);
      }

      // ─── Quests (future) ────────────────────────────────────────
      match /quests/{questId} {
        allow read: if isMember(campaignId);
        allow create, update, delete: if isGM(campaignId);
      }

      // ─── NPCs (future) ─────────────────────────────────────────
      match /npcs/{npcId} {
        allow read: if isGM(campaignId);
        allow create, update, delete: if isGM(campaignId);
      }
    }
  }
}
